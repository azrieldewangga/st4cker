# St4cker Desktop App - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# API Configuration (Vite Prefix Required)
# ============================================

# API Base URL - Your backend server URL
# Production: http://103.127.134.173:3000
# Development: http://localhost:3000
VITE_API_BASE_URL=http://103.127.134.173:3000

# WebSocket URL (usually same as API Base URL)
VITE_WEBSOCKET_URL=http://103.127.134.173:3000

# Agent API Key - Get from your backend .env file
VITE_AGENT_API_KEY=your-agent-api-key-here

# ============================================
# Other Configuration (optional)
# ============================================

# Node Environment
NODE_ENV=production

# Example for local development:
# VITE_API_BASE_URL=http://localhost:3000
# VITE_WEBSOCKET_URL=http://localhost:3000
# VITE_AGENT_API_KEY=st4cker-agent-secret
